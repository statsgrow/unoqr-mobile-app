{
  "expo": {
    "name": "Uno QR",
    "slug": "unoqr-app",
    "version": "1.0.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25813600-5e1d-4ae1-9c51-fd87d5ed6c8d"
    },
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "unoqr",
    "experiments": {
      "typedRoutes": true
    },
    "userInterfaceStyle": "light",
    "ios": {
      "version": "1.0.7",
      "buildNumber": "8",
      "appleTeamId": "5XXAGD7YYF",
      "bundleIdentifier": "com.statsgrow.unoqr",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development"
      }
    },
    "android": {
      "version": "1.0.8",
      "package": "com.statsgrow.unoqr",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FF5528",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 10
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "./app_helpers/android/release/withReleaseEnvironment",
      "./app_helpers/ios/release/withReleaseEnvironment",
      "./app_helpers/ios/withIOSBundling",
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Uno QR to use your camera to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Uno QR to use your location while saving a QR scan."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "./app_helpers/android/withUnoqrDownloads",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow Uno QR to measure which ads lead to app installs and actions so we can improve our advertising."
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1127503266516100",
          "clientToken": "5c134cc5026fc15da4d5bb175fe0f913",
          "displayName": "Uno QR",
          "scheme": "fb1127503266516100",
          "isAutoInitEnabled": false,
          "autoLogAppEventsEnabled": false,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "25813600-5e1d-4ae1-9c51-fd87d5ed6c8d"
      }
    },
    "owner": "statsgrow"
  }
}
