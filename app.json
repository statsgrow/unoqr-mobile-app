{
  "expo": {
    "name": "Uno QR",
    "slug": "unoqr-app",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25813600-5e1d-4ae1-9c51-fd87d5ed6c8d"
    },
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "unoqr",
    "experiments": {
      "typedRoutes": true
    },
    "userInterfaceStyle": "light",
    "ios": {
      "version": "1.0.1",
      "buildNumber": "2",
      "appleTeamId": "5XXAGD7YYF",
      "bundleIdentifier": "com.statsgrow.unoqr",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development"
      }
    },
    "android": {
      "version": "1.0.1",
      "package": "com.statsgrow.unoqr",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FF5528",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "./app_helpers/ios/withIOSBundling",
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Uno QR to use your camera to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Uno QR to use your location while saving a QR scan."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "./app_helpers/android/withUnoqrDownloads",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "25813600-5e1d-4ae1-9c51-fd87d5ed6c8d"
      }
    },
    "owner": "statsgrow"
  }
}
